# Site
NEXT_PUBLIC_SITE_URL=https://www.gautex.com

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Stripe — Visa, Mastercard, Amex, Apple Pay, Google Pay (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Firma del webhook (whsec_...) para confirmar pagos
STRIPE_WEBHOOK_SECRET=

# PayPal — https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_MODE=sandbox

# Email (required in production)
RESEND_API_KEY=
RESEND_FROM=Gautex Web <notificaciones@gautex.com>
CONTACT_EMAIL=info@gautex.com

# Uploads — Cloudinary recommended for production (Render filesystem is ephemeral)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# CRM webhook (optional — HubSpot, Pipedrive, Zapier, etc.)
CRM_WEBHOOK_URL=

# Render API (local only - never commit)
RENDER_API_KEY=
