# Site
NEXT_PUBLIC_SITE_URL=https://www.gautex.com

# Analytics — Google Analytics 4 (free)
# ID de medición Gautex: G-V86Q4399E2
# - Flujo web en GA4 apunta a https://www.gautex.com (go-live futuro)
# - Mientras tanto, probar en https://gautex-web-staging.onrender.com
# - En Render: ya en render.yaml; o .\scripts\setup-ga-render.ps1
NEXT_PUBLIC_GA_ID=G-V86Q4399E2
# Solo staging: logs de depuración en consola del navegador
# NEXT_PUBLIC_GA_DEBUG=true

# Plausible (paid cloud — optional alternative, leave empty)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Stripe — Visa, Mastercard, Amex, Apple Pay, Google Pay (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Firma del webhook (whsec_...) para confirmar pagos
STRIPE_WEBHOOK_SECRET=

# PayPal — https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_MODE=sandbox

# Email — Arsys SMTP (recomendado) o Resend como alternativa
SMTP_HOST=smtp.serviciodecorreo.es
SMTP_PORT=465
SMTP_USER=info@gautex.com
SMTP_PASS=
SMTP_FROM=Gautex Medica <info@gautex.com>
CONTACT_EMAIL=info@gautex.com

# Resend (opcional — solo si no usas SMTP Arsys)
RESEND_API_KEY=
RESEND_FROM=Gautex Medica <info@gautex.com>

# Uploads — Cloudinary OBLIGATORIO en producción (Render filesystem is ephemeral)
# Sin estas variables, /api/upload fallará en producción.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# CRM webhook (optional — HubSpot, Pipedrive, Zapier, etc.)
CRM_WEBHOOK_URL=

# Render API (local only - never commit)
RENDER_API_KEY=
