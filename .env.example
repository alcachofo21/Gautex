# Site
NEXT_PUBLIC_SITE_URL=https://www.gautex.com

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Stripe — Visa, Mastercard, Amex, Apple Pay, Google Pay (+ PayPal si activas en Dashboard)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# false = solo tarjeta/wallets hasta activar PayPal en Stripe Dashboard
STRIPE_PAYPAL_ENABLED=true

# Email (required in production)
RESEND_API_KEY=
RESEND_FROM=Gautex Web <notificaciones@gautex.com>
CONTACT_EMAIL=info@gautex.com

# Uploads — Cloudinary recommended for production (Render filesystem is ephemeral)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# CRM webhook (optional — HubSpot, Pipedrive, Zapier, etc.)
CRM_WEBHOOK_URL=

# Distributor portal access code
DISTRIBUTOR_ACCESS_CODE=

# Render API (local only - never commit)
RENDER_API_KEY=
